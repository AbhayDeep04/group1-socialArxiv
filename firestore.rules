rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Existing conversations rules
    match /conversations/{conversationId} {
      allow read, write: if isSignedIn();
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Bookmarks - user-specific
    match /users/{userId}/bookmarks/{paperId} {
      allow read, write: if isOwner(userId);
    }

    // Collection group read for notes (for library queries)
    match /{path=**}/notes/{noteId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Notes are private and nested by user and paper
    match /users/{userId}/papers/{paperId}/notes/{noteId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.paperId == paperId
        && request.resource.data.type in ['general', 'annotation']
        && request.resource.data.content is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (request.resource.data.type == 'general'
            || (
                 request.resource.data.annotation is map
              && request.resource.data.annotation.quote is string
              && request.resource.data.annotation.color is string
              && request.resource.data.annotation.pageRects is list
            ));

      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.paperId == resource.data.paperId
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isOwner(userId);
    }

    // Papers collection - arXiv papers (public) and user uploads (private)
    match /papers/{paperId} {
      allow read: if resource == null 
                  || resource.data.visibility == 'public' 
                  || (isSignedIn() && request.auth.uid == resource.data.ownerId);
      
      allow create: if isSignedIn() 
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.source in ['arxiv', 'upload']
                    && request.resource.data.visibility in ['private', 'unlisted', 'public']
                    && request.resource.data.status in ['uploading', 'uploaded', 'processing', 'ready', 'failed'];
      
      allow update: if isSignedIn() 
                    && request.auth.uid == resource.data.ownerId
                    && request.resource.data.ownerId == resource.data.ownerId;
      
      allow delete: if isSignedIn() 
                    && request.auth.uid == resource.data.ownerId;
    }

    // Collection group read for comments (for library queries)
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // Comments on papers - read-only for clients, writes via API
    match /papers/{paperId}/comments/{commentId} {
      allow read: if true;
      allow write: if false;
      
      match /votes/{voteId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // User ratings - user can read/write their own ratings
    match /users/{userId}/ratings/{paperId} {
      allow read, create, update, delete: if isOwner(userId)
        && (request.method in ['create', 'update'] 
            ? (request.resource.data.value in [1, 2, 3, 4, 5]
               && request.resource.data.updatedAt is timestamp
               && (request.method == 'create' ? request.resource.data.createdAt is timestamp : true))
            : true);
    }

    // Paper rating aggregates - read-only for clients, writes via API
    match /papers/{paperId}/aggregates/{aggId} {
      allow read: if true;
      allow write: if false;
    }

    // User documents - private settings (owner only)
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId) || isSignedIn();
    }

    // Public user profiles - readable by anyone, owner can write limited fields
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.data.displayName is string
        && (!request.resource.data.keys().hasAny(['bio']) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300))
        && (!request.resource.data.keys().hasAny(['institution']) || (request.resource.data.institution is string && request.resource.data.institution.size() <= 100))
        && (!request.resource.data.keys().hasAny(['location']) || (request.resource.data.location is string && request.resource.data.location.size() <= 100))
        && (!request.resource.data.keys().hasAny(['pinnedPaperIds']) || (request.resource.data.pinnedPaperIds is list && request.resource.data.pinnedPaperIds.size() <= 4))
        && request.resource.data.searchName is string;
    }

    // Follow relationships - read by anyone, write only via server (Admin SDK)
    match /profiles/{userId}/followers/{followerId} {
      allow read: if true;
      allow write: if false;
    }

    match /profiles/{userId}/following/{targetId} {
      allow read: if true;
      allow write: if false;
    }

    // Collection group read for bookmarks (for library queries)
    match /{path=**}/bookmarks/{paperId} {
      allow read: if isSignedIn();
    }
  }
}
